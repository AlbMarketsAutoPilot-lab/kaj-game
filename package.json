{
  "name": "kaj-game",
  "version": "0.1.0",
  "description": "KAJ — Kris Ann's Journey: a kid-friendly geography board game",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\"",
    "map:doc": "node scripts/map-table.ts",
    "build": "node scripts/build-web.ts",
    "android:assets": "npm run build && node -e \"require('fs').mkdirSync('android/app/src/main/assets',{recursive:true});require('fs').copyFileSync('dist/kaj.html','android/app/src/main/assets/index.html')\""
  },
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "topojson-client": "^3.1.0",
    "topojson-server": "^3.0.1",
    "topojson-simplify": "^3.0.3",
    "typescript": "^7.0.2"
  }
}
